import React, { useEffect, useState } from 'react';
import { createCourse, updateCourse, uploadFileToServer } from '../../api/services';
import type { Categorie, Cours } from '../../types';
import { resolveSafeUrl } from '../../utils/url';
import { Image as ImageIcon } from 'lucide-react';

interface CourseFormModalProps {
  categories: Categorie[];
  courseToEdit?: Cours | null;
  onClose: () => void;
  onSaved: () => void;
}

export default function CourseFormModal({
  categories,
  courseToEdit,
  onClose,
  onSaved,
}: CourseFormModalProps) {
  const isEditing = Boolean(courseToEdit);

  const [title, setTitle] = useState('');
  const [description, setDescription] = useState('');
  const [categoryId, setCategoryId] = useState<number>(categories[0]?.id_categorie ?? 1);
  const [isPublished, setIsPublished] = useState(true);
  const [coverUrl, setCoverUrl] = useState('');
  const [estimatedDuration, setEstimatedDuration] = useState('');
  const [difficultyLevel, setDifficultyLevel] = useState('Beginner');
  const [prerequisites, setPrerequisites] = useState('');
  const [uploadingCover, setUploadingCover] = useState(false);
  const [submitting, setSubmitting] = useState(false);

  useEffect(() => {
    if (courseToEdit) {
      setTitle(courseToEdit.titre);
      setDescription(courseToEdit.description);
      setCategoryId(courseToEdit.id_categorie);
      setIsPublished(courseToEdit.est_publie);
      setCoverUrl(courseToEdit.cover_url || '');
      setEstimatedDuration(courseToEdit.estimated_duration || '');
      setDifficultyLevel(courseToEdit.difficulty_level || 'Beginner');
      setPrerequisites(courseToEdit.prerequisites || '');
    } else {
      setTitle('');
      setDescription('');
      setCategoryId(categories[0]?.id_categorie ?? 1);
      setIsPublished(true);
      setCoverUrl('');
      setEstimatedDuration('');
      setDifficultyLevel('Beginner');
      setPrerequisites('');
    }
  }, [courseToEdit, categories]);

  const handleCoverUpload = async (file: File) => {
    setUploadingCover(true);
    try {
      const uploaded = await uploadFileToServer(file);
      setCoverUrl(uploaded.chemin_fichier);
    } catch (err) {
      console.error(err);
      alert("Erreur lors de l'upload de l'image de couverture.");
    } finally {
      setUploadingCover(false);
    }
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setSubmitting(true);
    try {
      const payload = {
        titre: title,
        description,
        est_publie: isPublished,
        id_categorie: Number(categoryId),
        cover_url: coverUrl.trim(),
        estimated_duration: estimatedDuration.trim(),
        difficulty_level: difficultyLevel,
        prerequisites: prerequisites.trim(),
      };

      if (isEditing && courseToEdit) {
        await updateCourse(courseToEdit.id_cours, payload);
        alert('Cours mis à jour avec succès !');
      } else {
        await createCourse(payload);
        alert('Cours créé avec succès !');
      }

      onSaved();
      onClose();
    } catch (err) {
      console.error(err);
      alert(isEditing ? 'Erreur lors de la mise à jour.' : 'Erreur lors de la création du cours.');
    } finally {
      setSubmitting(false);
    }
  };

  const previewSrc = resolveSafeUrl(coverUrl);

  return (
    <div className="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4 z-50">
      <div className="bg-white rounded-3xl max-w-lg w-full p-7 shadow-2xl space-y-6 max-h-[90vh] overflow-y-auto">
        <div className="flex justify-between items-center border-b border-gray-100 pb-4">
          <h3 className="text-xl font-extrabold text-gray-900">
            {isEditing ? 'Modifier le cours' : 'Créer un nouveau cours'}
          </h3>
          <button
            type="button"
            onClick={onClose}
            className="text-gray-400 hover:text-gray-600 font-bold cursor-pointer"
          >
            ✕
          </button>
        </div>

        <form onSubmit={handleSubmit} className="space-y-4">
          <div>
            <label className="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1">
              Titre du cours
            </label>
            <input
              type="text"
              value={title}
              onChange={(e) => setTitle(e.target.value)}
              required
              className="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-xl text-sm"
            />
          </div>

          <div>
            <label className="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1">
              Description
            </label>
            <textarea
              value={description}
              onChange={(e) => setDescription(e.target.value)}
              required
              rows={3}
              className="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-xl text-sm"
            />
          </div>

          <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label className="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1">
                Catégorie
              </label>
              <select
                value={categoryId}
                onChange={(e) => setCategoryId(Number(e.target.value))}
                className="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-xl text-sm"
              >
                {categories.map((cat) => (
                  <option key={cat.id_categorie} value={cat.id_categorie}>
                    {cat.nom}
                  </option>
                ))}
              </select>
            </div>

            <div>
              <label className="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1">
                Niveau de difficulté
              </label>
              <select
                value={difficultyLevel}
                onChange={(e) => setDifficultyLevel(e.target.value)}
                className="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-xl text-sm"
              >
                <option value="Beginner">Beginner</option>
                <option value="Intermediate">Intermediate</option>
                <option value="Advanced">Advanced</option>
              </select>
            </div>
          </div>

          <div>
            <label className="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1">
              Durée estimée
            </label>
            <input
              type="text"
              value={estimatedDuration}
              onChange={(e) => setEstimatedDuration(e.target.value)}
              placeholder="ex: 6 hours"
              className="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-xl text-sm"
            />
          </div>

          <div>
            <label className="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1">
              Prérequis
            </label>
            <textarea
              value={prerequisites}
              onChange={(e) => setPrerequisites(e.target.value)}
              placeholder="ex: Notions de base en Python, HTTP et REST"
              rows={2}
              className="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-xl text-sm"
            />
          </div>

          <div className="space-y-2">
            <label className="block text-xs font-bold uppercase tracking-wider text-gray-600 flex items-center space-x-1.5">
              <ImageIcon className="w-3.5 h-3.5 text-indigo-600" />
              <span>Image de couverture (fichier ou URL)</span>
            </label>
            <input
              type="file"
              accept="image/*"
              onChange={(e) => {
                if (e.target.files && e.target.files[0]) {
                  handleCoverUpload(e.target.files[0]);
                }
              }}
              className="w-full px-3 py-2 bg-gray-50 border border-gray-300 rounded-xl text-xs file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:font-bold file:bg-indigo-50 file:text-indigo-700 cursor-pointer"
            />
            <input
              type="text"
              value={coverUrl}
              onChange={(e) => setCoverUrl(e.target.value)}
              placeholder="https://... ou /uploads/..."
              className="w-full px-4 py-2 bg-gray-50 border border-gray-300 rounded-xl text-xs"
            />
            {uploadingCover && (
              <p className="text-xs text-indigo-600 font-semibold">Téléversement de la couverture...</p>
            )}
            {previewSrc && (
              <div className="relative h-28 w-full rounded-xl overflow-hidden border border-gray-200 bg-gray-100">
                <img src={previewSrc} alt="Aperçu couverture" className="w-full h-full object-cover" />
              </div>
            )}
          </div>

          <div className="flex items-center space-x-2">
            <input
              type="checkbox"
              id="course-pub"
              checked={isPublished}
              onChange={(e) => setIsPublished(e.target.checked)}
              className="w-4 h-4 text-indigo-600 rounded"
            />
            <label htmlFor="course-pub" className="text-sm font-semibold text-gray-700">
              {isEditing ? 'Publié' : 'Publier immédiatement'}
            </label>
          </div>

          <div className="flex space-x-3 pt-2">
            <button
              type="button"
              onClick={onClose}
              className="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 py-2.5 rounded-xl text-sm font-bold cursor-pointer"
            >
              Annuler
            </button>
            <button
              type="submit"
              disabled={uploadingCover || submitting}
              className="flex-1 bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 text-white py-2.5 rounded-xl text-sm font-bold shadow-sm cursor-pointer"
            >
              {submitting ? 'Enregistrement...' : isEditing ? 'Enregistrer' : 'Créer le cours'}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}
