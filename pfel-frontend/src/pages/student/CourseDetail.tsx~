// File: src/pages/student/CourseDetail.tsx
import React, { useEffect, useState } from 'react';
import { useParams, useNavigate } from 'react-router-dom';
import { 
  getCatalog, 
  getCourseResources, 
  getCourseEvaluations, 
  getCourseForum, 
  postForumMessage,
  submitEvaluation 
} from '../../api/services';
import type { Cours, Ressource, Evaluation } from '../../types';
import { BookOpen, FileText, CheckSquare, MessageSquare, ArrowLeft, Upload, Send } from 'lucide-react';

export default function CourseDetail() {
  const { id } = useParams<{ id: string }>();
  const navigate = useNavigate();
  
  const [course, setCourse] = useState<Cours | null>(null);
  const [resources, setResources] = useState<Ressource[]>([]);
  const [evaluations, setEvaluations] = useState<Evaluation[]>([]);
  const [forumMessages, setForumMessages] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);

  // Modal soumission devoir
  const [selectedEval, setSelectedEval] = useState<Evaluation | null>(null);
  const [submissionPath, setSubmissionPath] = useState('');
  const [newMsg, setNewMsg] = useState('');

  const courseId = Number(id);

  const fetchCourseData = async () => {
    try {
      // 1. Récupérer le catalogue pour trouver le cours
      const catalog = await getCatalog();
      const currentCourse = (catalog || []).find((c: Cours) => c.id_cours === courseId);
      setCourse(currentCourse || null);
    } catch (err) {
      console.error("Erreur lors de la récupération du cours:", err);
    }

    // 2. Récupérer les ressources (isolé pour éviter de bloquer la page si vide)
    try {
      const resData = await getCourseResources(courseId);
      setResources(resData || []);
    } catch (err) {
      setResources([]);
    }

    // 3. Récupérer les évaluations
    try {
      const evalData = await getCourseEvaluations(courseId);
      setEvaluations(evalData || []);
    } catch (err) {
      setEvaluations([]);
    }

    // 4. Récupérer le forum
    try {
      const forumData = await getCourseForum(courseId);
      setForumMessages(forumData || []);
    } catch (err) {
      setForumMessages([]);
    }

    setLoading(false);
  };

  useEffect(() => {
    if (courseId) {
      fetchCourseData();
    }
  }, [courseId]);

  const handlePostMessage = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!newMsg.trim()) return;
    try {
      await postForumMessage(courseId, newMsg);
      setNewMsg('');
      fetchCourseData();
    } catch (err) {
      console.error(err);
      alert("Erreur lors de l'envoi du message.");
    }
  };

  const handleSubmitWork = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!selectedEval) return;
    try {
      await submitEvaluation(selectedEval.id_evaluation, submissionPath);
      alert('Devoir soumis avec succès !');
      setSelectedEval(null);
      setSubmissionPath('');
    } catch (err) {
      console.error(err);
      alert("Erreur lors de la soumission du devoir.");
    }
  };

  if (loading) {
    return <div className="text-center mt-12 text-gray-500 font-medium">Chargement du cours...</div>;
  }

  if (!course) {
    return (
      <div className="text-center mt-12 space-y-4">
        <p className="text-red-500 font-medium">Cours introuvable ou non publié.</p>
        <button onClick={() => navigate(-1)} className="text-indigo-600 font-bold hover:underline">
          Retourner en arrière
        </button>
      </div>
    );
  }

  return (
    <div className="space-y-8 max-w-5xl mx-auto pb-12">
      {/* Bouton retour */}
      <button 
        onClick={() => navigate(-1)} 
        className="inline-flex items-center space-x-2 text-indigo-600 font-bold hover:underline cursor-pointer"
      >
        <ArrowLeft className="w-4 h-4" />
        <span>Retour</span>
      </button>

      {/* En-tête du cours */}
      <div className="bg-gradient-to-r from-indigo-700 to-violet-800 rounded-2xl p-8 text-white shadow-xl space-y-3">
        <span className="text-xs font-bold uppercase tracking-wider bg-white/20 px-3 py-1 rounded-full">
          Catégorie #{course.id_categorie}
        </span>
        <h1 className="text-3xl font-extrabold">{course.titre}</h1>
        <p className="text-indigo-100 text-sm max-w-2xl">{course.description}</p>
      </div>

      {/* Grille principale : Ressources & Évaluations */}
      <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
        {/* Section Ressources */}
        <div className="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm space-y-4">
          <div className="flex items-center space-x-2 text-indigo-700 font-bold text-lg border-b pb-3">
            <FileText className="w-5 h-5" />
            <span>Supports & Ressources du cours</span>
          </div>
          {resources.length === 0 ? (
            <p className="text-sm text-gray-500 italic">Aucune ressource disponible pour l'instant.</p>
          ) : (
            <div className="space-y-3">
              {resources.map((res) => (
                <div key={res.id_ressource} className="p-4 bg-gray-50 rounded-xl border border-gray-200 flex items-center justify-between">
                  <div>
                    <h4 className="font-bold text-gray-900 text-sm">{res.nom_fichier}</h4>
                    <span className="text-xs text-indigo-600 uppercase font-semibold">{res.type_fichier}</span>
                  </div>
                  <a 
                    href={res.chemin_fichier} 
                    target="_blank" 
                    rel="noreferrer"
                    className="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold px-3 py-2 rounded-lg transition"
                  >
                    Accéder
                  </a>
                </div>
              ))}
            </div>
          )}
        </div>

        {/* Section Évaluations */}
        <div className="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm space-y-4">
          <div className="flex items-center space-x-2 text-violet-700 font-bold text-lg border-b pb-3">
            <CheckSquare className="w-5 h-5" />
            <span>Évaluations & Devoirs</span>
          </div>
          {evaluations.length === 0 ? (
            <p className="text-sm text-gray-500 italic">Aucune évaluation programmée pour le moment.</p>
          ) : (
            <div className="space-y-3">
              {evaluations.map((ev) => (
                <div key={ev.id_evaluation} className="p-4 bg-gray-50 rounded-xl border border-gray-200 space-y-2">
                  <div className="flex justify-between items-start">
                    <h4 className="font-bold text-gray-900 text-sm">{ev.titre}</h4>
                    <span className="text-xs font-semibold bg-violet-100 text-violet-700 px-2 py-0.5 rounded-full">
                      Barème : {ev.bareme} pts
                    </span>
                  </div>
                  <p className="text-xs text-gray-600">{ev.instructions}</p>
                  <button
                    onClick={() => setSelectedEval(ev)}
                    className="w-full mt-2 bg-violet-600 hover:bg-violet-700 text-white text-xs font-bold py-2 rounded-lg transition flex items-center justify-center space-x-1 cursor-pointer"
                  >
                    <Upload className="w-3.5 h-3.5" />
                    <span>Soumettre mon travail</span>
                  </button>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>

      {/* Section Forum / Discussion */}
      <div className="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm space-y-4">
        <div className="flex items-center space-x-2 text-gray-900 font-bold text-lg border-b pb-3">
          <MessageSquare className="w-5 h-5 text-indigo-600" />
          <span>Forum de discussion</span>
        </div>

        <div className="space-y-3 max-h-64 overflow-y-auto pr-2">
          {forumMessages.length === 0 ? (
            <p className="text-sm text-gray-500 italic">Soyez le premier à lancer une discussion sur ce cours !</p>
          ) : (
            forumMessages.map((msg, idx) => (
              <div key={idx} className="p-3 bg-gray-50 rounded-xl border border-gray-100 space-y-1">
                <span className="text-xs font-bold text-indigo-700 block">{msg.nom_auteur || 'Utilisateur'}</span>
                <p className="text-sm text-gray-800">{msg.contenu}</p>
              </div>
            ))
          )}
        </div>

        <form onSubmit={handlePostMessage} className="flex gap-2 pt-2 border-t">
          <input 
            type="text" 
            value={newMsg} 
            onChange={(e) => setNewMsg(e.target.value)} 
            placeholder="Écrire un message dans le forum..." 
            required 
            className="flex-1 px-4 py-2.5 bg-gray-50 border rounded-xl text-sm"
          />
          <button type="submit" className="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-xl font-bold text-sm flex items-center space-x-1 cursor-pointer">
            <Send className="w-4 h-4" />
            <span>Envoyer</span>
          </button>
        </form>
      </div>

      {/* MODAL : SOUMISSION DE DEVOIR */}
      {selectedEval && (
        <div className="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4 z-50">
          <div className="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl space-y-6">
            <div className="flex justify-between items-center">
              <h3 className="text-lg font-bold text-gray-900">Soumettre : {selectedEval.titre}</h3>
              <button onClick={() => setSelectedEval(null)} className="text-gray-400 hover:text-gray-600 font-bold">✕</button>
            </div>

            <form onSubmit={handleSubmitWork} className="space-y-4">
              <div>
                <label className="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1">Lien ou chemin du fichier rendu</label>
                <input 
                  type="text" 
                  value={submissionPath} 
                  onChange={(e) => setSubmissionPath(e.target.value)} 
                  placeholder="/uploads/devoirs/mon_projet.zip" 
                  required 
                  className="w-full px-4 py-2.5 bg-gray-50 border rounded-xl text-sm" 
                />
              </div>

              <div className="flex space-x-3 pt-2">
                <button type="button" onClick={() => setSelectedEval(null)} className="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 py-2.5 rounded-xl text-sm font-medium">Annuler</button>
                <button type="submit" className="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white py-2.5 rounded-xl text-sm font-medium shadow-sm">Valider le rendu</button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}
