import React, { useMemo, useState } from 'react';
import { useNavigate } from 'react-router-dom';
import type { Cours } from '../../types';
import { CARD_THEMES, type TeacherCourseStats } from './teacherDashboard.types';
import { resolveSafeUrl } from '../../utils/url';
import {
  BookOpen,
  PlusCircle,
  Edit,
  Upload,
  Search,
  CheckCircle2,
  Clock,
  TrendingUp,
  Eye,
  FolderPlus,
  GraduationCap,
} from 'lucide-react';

interface CoursesTabProps {
  courses: Cours[];
  categoryMap: Map<number, string>;
  courseStats: Record<number, TeacherCourseStats>;
  globalStats: {
    totalCourses: number;
    publishedCourses: number;
    draftCourses: number;
  };
  onOpenCreateCourse: () => void;
  onEditCourse: (course: Cours) => void;
  onOpenModules: (course: Cours) => void;
  onOpenResourceUpload: (course: Cours) => void;
  onOpenEvaluationCreate: (course: Cours) => void;
}

export default function CoursesTab({
  courses,
  categoryMap,
  courseStats,
  globalStats,
  onOpenCreateCourse,
  onEditCourse,
  onOpenModules,
  onOpenResourceUpload,
  onOpenEvaluationCreate,
}: CoursesTabProps) {
  const navigate = useNavigate();
  const [searchQuery, setSearchQuery] = useState('');
  const [pubFilter, setPubFilter] = useState<'all' | 'published' | 'draft'>('all');

  const filteredCourses = useMemo(() => {
    return courses.filter((c) => {
      const matchesSearch =
        c.titre.toLowerCase().includes(searchQuery.toLowerCase()) ||
        c.description.toLowerCase().includes(searchQuery.toLowerCase());
      if (!matchesSearch) return false;
      if (pubFilter === 'published') return c.est_publie;
      if (pubFilter === 'draft') return !c.est_publie;
      return true;
    });
  }, [courses, searchQuery, pubFilter]);

  return (
    <div className="space-y-6">
      <div className="flex flex-col sm:flex-row sm:items-center justify-end gap-3">
        <div className="inline-flex bg-gray-100 p-1 rounded-xl text-xs font-bold">
          <button
            type="button"
            onClick={() => setPubFilter('all')}
            className={`px-3 py-1.5 rounded-lg transition cursor-pointer ${
              pubFilter === 'all' ? 'bg-white text-gray-900 shadow-2xs' : 'text-gray-600'
            }`}
          >
            Tous ({globalStats.totalCourses})
          </button>
          <button
            type="button"
            onClick={() => setPubFilter('published')}
            className={`px-3 py-1.5 rounded-lg transition cursor-pointer ${
              pubFilter === 'published' ? 'bg-white text-emerald-700 shadow-2xs' : 'text-gray-600'
            }`}
          >
            Publiés ({globalStats.publishedCourses})
          </button>
          <button
            type="button"
            onClick={() => setPubFilter('draft')}
            className={`px-3 py-1.5 rounded-lg transition cursor-pointer ${
              pubFilter === 'draft' ? 'bg-white text-amber-700 shadow-2xs' : 'text-gray-600'
            }`}
          >
            Brouillons ({globalStats.draftCourses})
          </button>
        </div>

        <div className="relative">
          <Search className="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" />
          <input
            type="text"
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            placeholder="Rechercher un cours..."
            className="pl-10 pr-4 py-2 bg-white border border-gray-200 rounded-xl text-xs font-medium text-gray-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 w-full sm:w-56"
          />
        </div>
      </div>

      {courses.length === 0 ? (
        <div className="bg-white rounded-3xl p-12 border border-dashed border-gray-300 text-center space-y-4 max-w-lg mx-auto my-8">
          <div className="w-16 h-16 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center mx-auto">
            <BookOpen className="w-8 h-8" />
          </div>
          <h3 className="text-xl font-extrabold text-gray-900">Vous n'avez pas encore créé de cours</h3>
          <p className="text-sm text-gray-500">
            Lancez votre premier module d'enseignement pour commencer à partager des supports et évaluations.
          </p>
          <button
            onClick={onOpenCreateCourse}
            className="inline-flex items-center space-x-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm px-6 py-3 rounded-xl transition shadow-md cursor-pointer"
          >
            <PlusCircle className="w-4 h-4" />
            <span>Créer mon premier cours</span>
          </button>
        </div>
      ) : filteredCourses.length === 0 ? (
        <div className="bg-white rounded-2xl p-10 border border-gray-200 text-center text-gray-500">
          Aucun cours ne correspond à votre recherche.
        </div>
      ) : (
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
          {filteredCourses.map((course, idx) => {
            const theme = CARD_THEMES[idx % CARD_THEMES.length];
            const categoryName = categoryMap.get(course.id_categorie) || `Catégorie #${course.id_categorie}`;
            const st = courseStats[course.id_cours] || {
              resourceCount: 0,
              evalCount: 0,
              studentCount: 0,
              avgProgress: 0,
            };
            const coverSrc = resolveSafeUrl(course.cover_url);

            return (
              <div
                key={course.id_cours}
                onClick={() => navigate(`/cours/${course.id_cours}`)}
                className="group bg-white rounded-3xl border border-gray-200/90 shadow-xs hover:shadow-xl hover:-translate-y-1.5 hover:border-indigo-300 transition-all duration-300 flex flex-col justify-between overflow-hidden cursor-pointer"
              >
                <div>
                  <div className={`relative bg-gradient-to-r ${theme.gradient} p-6 text-white overflow-hidden`}>
                    {coverSrc && (
                      <img
                        src={coverSrc}
                        alt={course.titre}
                        className="absolute inset-0 w-full h-full object-cover opacity-35"
                      />
                    )}
                    <div className="absolute -right-6 -bottom-6 w-28 h-28 bg-white/10 rounded-full blur-xl pointer-events-none"></div>

                    <div className="flex items-center justify-between gap-2 relative z-10 mb-3">
                      <span className="text-[11px] font-extrabold uppercase tracking-wider bg-black/35 backdrop-blur-xs text-white px-3 py-1 rounded-full border border-white/15 truncate">
                        {categoryName}
                      </span>

                      <span
                        className={`text-[11px] font-extrabold px-2.5 py-1 rounded-full flex items-center space-x-1 shrink-0 ${
                          course.est_publie
                            ? 'bg-emerald-400/25 text-emerald-100 border border-emerald-300/30'
                            : 'bg-amber-400/25 text-amber-100 border border-amber-300/30'
                        }`}
                      >
                        {course.est_publie ? (
                          <>
                            <CheckCircle2 className="w-3.5 h-3.5 text-emerald-300" />
                            <span>Publié</span>
                          </>
                        ) : (
                          <>
                            <Clock className="w-3.5 h-3.5 text-amber-300" />
                            <span>Brouillon</span>
                          </>
                        )}
                      </span>
                    </div>

                    <h3 className="relative z-10 text-xl font-extrabold leading-snug line-clamp-2 group-hover:underline decoration-white/60 underline-offset-4">
                      {course.titre}
                    </h3>
                  </div>

                  <div className="p-6 space-y-5">
                    <div className="flex flex-wrap items-center gap-2 text-xs">
                      <span className="inline-flex items-center space-x-1 font-bold bg-indigo-50 text-indigo-700 px-2.5 py-1 rounded-lg">
                        <GraduationCap className="w-3.5 h-3.5" />
                        <span>{course.difficulty_level || 'Beginner'}</span>
                      </span>
                      {course.estimated_duration && (
                        <span className="inline-flex items-center space-x-1 font-semibold bg-gray-100 text-gray-700 px-2.5 py-1 rounded-lg">
                          <Clock className="w-3.5 h-3.5 text-gray-500" />
                          <span>{course.estimated_duration}</span>
                        </span>
                      )}
                    </div>

                    <p className="text-gray-600 text-sm leading-relaxed line-clamp-2 min-h-[40px]">
                      {course.description}
                    </p>

                    {course.prerequisites && (
                      <p className="text-xs text-gray-500 bg-gray-50 px-3 py-2 rounded-xl border border-gray-100 line-clamp-1">
                        <strong className="text-gray-700">Prérequis :</strong> {course.prerequisites}
                      </p>
                    )}

                    <div className="grid grid-cols-3 gap-2 pt-1">
                      <div className="bg-gray-50 border border-gray-100 rounded-xl p-2.5 text-center">
                        <span className="block text-sm font-extrabold text-gray-900">{st.studentCount}</span>
                        <span className="block text-[10px] font-bold uppercase text-gray-400">Inscrits</span>
                      </div>
                      <div className="bg-gray-50 border border-gray-100 rounded-xl p-2.5 text-center">
                        <span className="block text-sm font-extrabold text-indigo-600">{st.resourceCount}</span>
                        <span className="block text-[10px] font-bold uppercase text-gray-400">Supports</span>
                      </div>
                      <div className="bg-gray-50 border border-gray-100 rounded-xl p-2.5 text-center">
                        <span className="block text-sm font-extrabold text-violet-600">{st.evalCount}</span>
                        <span className="block text-[10px] font-bold uppercase text-gray-400">Évals</span>
                      </div>
                    </div>

                    <div className="space-y-1.5">
                      <div className="flex items-center justify-between text-xs">
                        <span className="font-bold text-gray-500 flex items-center space-x-1">
                          <TrendingUp className="w-3.5 h-3.5 text-indigo-600" />
                          <span>Progression moyenne</span>
                        </span>
                        <span className="font-extrabold text-gray-900">{st.avgProgress}%</span>
                      </div>
                      <div className="w-full bg-gray-100 rounded-full h-2 overflow-hidden">
                        <div
                          className={`h-full rounded-full transition-all duration-500 ${theme.barColor}`}
                          style={{ width: `${Math.min(st.avgProgress, 100)}%` }}
                        />
                      </div>
                    </div>
                  </div>
                </div>

                <div
                  className="px-6 pb-6 pt-4 border-t border-gray-100 bg-gray-50/50 space-y-2.5"
                  onClick={(e) => e.stopPropagation()}
                >
                  <button
                    onClick={() => onOpenModules(course)}
                    className="w-full bg-slate-900 hover:bg-slate-800 text-white font-bold py-2 px-3 rounded-xl text-xs transition flex items-center justify-center space-x-1.5 shadow-2xs cursor-pointer"
                  >
                    <FolderPlus className="w-3.5 h-3.5 text-indigo-300" />
                    <span>Chapitres & Organisation</span>
                  </button>

                  <div className="grid grid-cols-2 gap-2">
                    <button
                      onClick={() => onOpenResourceUpload(course)}
                      className="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2.5 px-3 rounded-xl text-xs transition flex items-center justify-center space-x-1.5 shadow-2xs cursor-pointer"
                    >
                      <Upload className="w-3.5 h-3.5" />
                      <span>+ Ressource</span>
                    </button>

                    <button
                      onClick={() => onOpenEvaluationCreate(course)}
                      className="bg-violet-600 hover:bg-violet-700 text-white font-bold py-2.5 px-3 rounded-xl text-xs transition flex items-center justify-center space-x-1.5 shadow-2xs cursor-pointer"
                    >
                      <PlusCircle className="w-3.5 h-3.5" />
                      <span>+ Évaluation</span>
                    </button>
                  </div>

                  <div className="flex items-center gap-2">
                    <button
                      onClick={() => onEditCourse(course)}
                      className="flex-1 bg-white hover:bg-gray-100 text-gray-700 border border-gray-200 font-bold py-2 rounded-xl text-xs transition flex items-center justify-center space-x-1.5 cursor-pointer"
                    >
                      <Edit className="w-3.5 h-3.5 text-gray-500" />
                      <span>Modifier</span>
                    </button>

                    <button
                      onClick={() => navigate(`/cours/${course.id_cours}`)}
                      className="flex-1 bg-white hover:bg-indigo-50 text-indigo-600 border border-gray-200 font-bold py-2 rounded-xl text-xs transition flex items-center justify-center space-x-1.5 cursor-pointer"
                    >
                      <Eye className="w-3.5 h-3.5" />
                      <span>Aperçu cours</span>
                    </button>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  );
}
