/* File: src/styles/tokens.css */
:root {
  /* Surfaces — warm Claude-like parchment & stone */
  --bg-canvas: #faf9f6;
  --bg-surface: #ffffff;
  --bg-subtle: #f3f1ec;
  --bg-hover: #eae6de;
  --bg-hero: #f5f2eb;

  /* Text */
  --text-primary: #1a1918;
  --text-secondary: #57534e;
  --text-muted: #878279;
  --text-inverse: #ffffff;

  /* Borders */
  --border-subtle: #e6e2d8;
  --border-strong: #d5cfc2;

  /* Accent — warm terracotta */
  --accent: #c96442;
  --accent-hover: #b25333;
  --accent-soft: #f7ebe6;
  --accent-text: #9e472a;
  --accent-border: #e6c3b5;

  /* Semantic status */
  --success-bg: #eef5f0;
  --success-text: #276749;
  --success-border: #c6e2cf;

  --warning-bg: #fbf3e4;
  --warning-text: #8c5a14;
  --warning-border: #ebd4a7;

  --danger-bg: #fdf0ee;
  --danger-text: #9b2c2c;
  --danger-border: #f2c5c0;

  /* Radii & Elevation */
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 20px;
  --shadow-card: 0 1px 2px rgba(26, 25, 24, 0.04);
  --shadow-modal: 0 18px 42px rgba(26, 25, 24, 0.14);
}

.dark {
  --bg-canvas: #141413;
  --bg-surface: #1c1c1a;
  --bg-subtle: #252522;
  --bg-hover: #2e2e2a;
  --bg-hero: #1f1e1b;

  --text-primary: #eceae4;
  --text-secondary: #b5b0a6;
  --text-muted: #7d786e;
  --text-inverse: #141413;

  --border-subtle: #2e2d29;
  --border-strong: #3f3e38;

  --accent: #d97757;
  --accent-hover: #e38667;
  --accent-soft: rgba(217, 119, 87, 0.14);
  --accent-text: #e89578;
  --accent-border: rgba(217, 119, 87, 0.35);

  --success-bg: rgba(39, 103, 73, 0.18);
  --success-text: #74d19e;
  --success-border: rgba(116, 209, 158, 0.28);

  --warning-bg: rgba(180, 120, 30, 0.18);
  --warning-text: #ecc272;
  --warning-border: rgba(236, 194, 114, 0.28);

  --danger-bg: rgba(185, 55, 55, 0.18);
  --danger-text: #f29494;
  --danger-border: rgba(242, 148, 148, 0.28);

  --shadow-card: 0 1px 2px rgba(0, 0, 0, 0.25);
  --shadow-modal: 0 20px 48px rgba(0, 0, 0, 0.55);
}
